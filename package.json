{
  "name": "scrappy",
  "version": "1.1.0",
  "description": "Scrappy — an articulated robot desk companion that fetches you when a Cursor agent finishes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js && python3 -m unittest discover -s test -p 'test_*.py'",
    "install-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-startup.ps1",
    "uninstall-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/uninstall-startup.ps1",
    "install-hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-cursor-hooks.ps1",
    "setup-voice": "node ./scripts/setup-voice.js",
    "setup-local-voice": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-local-voice.ps1",
    "model:qwen14": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/switch-local-model.ps1 qwen2.5:14b",
    "model:gemma9": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/switch-local-model.ps1 gemma2:9b",
    "model:qwen7": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/switch-local-model.ps1 qwen2.5:7b",
    "model:r1-14": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/switch-local-model.ps1 deepseek-r1:14b",
    "build-icon": "node ./scripts/build-icon.js",
    "build-tray": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-tray.ps1",
    "build-site": "node ./scripts/build-site.js",
    "dev-site": "node ./scripts/build-site.js && npx wrangler dev",
    "deploy-site": "node ./scripts/build-site.js && npx wrangler deploy",
    "process-log": "node ./scripts/process-log.js",
    "conversations": "node ./scripts/process-log.js 80",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --win --dir"
  },
  "author": "Jake Zimmer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imjakezimmer32/scrappy.git"
  },
  "homepage": "https://imscrappy.dev",
  "bugs": {
    "url": "https://github.com/imjakezimmer32/scrappy/issues"
  },
  "build": {
    "appId": "com.hellalogic.scrappy",
    "productName": "Scrappy",
    "copyright": "Copyright © 2026 Jake Zimmer",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!site/**",
      "!docs/**",
      "!test/**",
      "!release/**",
      "!local-voice/.venv/**",
      "!local-voice/logs/**",
      "!local-voice/models/**",
      "!conversations/**",
      "!process-logs/**"
    ],
    "win": {
      "icon": "assets/scrappy.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scrappy-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "imjakezimmer32",
      "repo": "scrappy"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Scrappy",
      "runAfterFinish": true,
      "uninstallDisplayName": "Scrappy"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.27"
  }
}
