{
  "name": "workbuddy",
  "version": "1.0.0",
  "description": "Cog — an articulated robot desktop buddy that fetches you when a Cursor agent finishes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "install-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-startup.ps1",
    "uninstall-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/uninstall-startup.ps1",
    "install-hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-cursor-hooks.ps1",
    "setup-voice": "node ./scripts/setup-voice.js",
    "setup-local-voice": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-local-voice.ps1",
    "model:qwen14": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/switch-local-model.ps1 qwen2.5:14b",
    "model:gemma9": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/switch-local-model.ps1 gemma2:9b",
    "model:qwen7": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/switch-local-model.ps1 qwen2.5:7b",
    "model:r1-14": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/switch-local-model.ps1 deepseek-r1:14b",
    "process-log": "node ./scripts/process-log.js",
    "conversations": "node ./scripts/process-log.js 80"
  },
  "author": "Jake",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.27"
  }
}
